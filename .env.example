# Opcion 1: URL completa (tiene prioridad)
DATABASE_URL=postgresql://postgres:...@localhost:5432/biblioteca_13

# Opcion 2: variables separadas (se usan si DATABASE_URL esta vacia)
DB_USER=postgres
DB_PASSWORD=...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca_13

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=10

# Servidor
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DIAS_PRESTAMO=14
